{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["./typings", "./node_modules/@types"]
  },
  "include": ["pi/index.ts", "openclaw/index.ts", "typings/**/*.d.ts"]
}
